{
  "name": "dice-atelier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/version.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && node scripts/client-queue-check.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test",
    "deploy": "wrangler deploy",
    "build:worker": "wrangler deploy --dry-run --outdir dist-worker",
    "test:persistence": "node scripts/persistence.mjs && node scripts/tikatuka-persistence.mjs",
    "prepare": "node scripts/version.mjs",
    "dev:ci": "node scripts/ci-server.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260906.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.185.4",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "wrangler": "4.129.0"
  },
  "engines": {
    "node": ">=24.14.0"
  }
}
