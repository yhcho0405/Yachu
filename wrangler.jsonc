{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dice-atelier",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/internal/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      { "name": "REGISTRY", "class_name": "SessionRegistry" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom", "SessionRegistry"] }],
  "secrets": { "required": ["SESSION_SECRET"] },
  "observability": { "enabled": false },
}
